{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextplayer.local/contracts/offline-model-manifest.schema.json",
  "title": "NextPlayer Offline Subtitle Model Manifest",
  "type": "object",
  "required": [
    "manifestVersion",
    "modelId",
    "displayName",
    "version",
    "sourceLanguage",
    "targetLanguages",
    "capabilities",
    "files"
  ],
  "properties": {
    "manifestVersion": {
      "type": "integer",
      "minimum": 1
    },
    "modelId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "sourceLanguage": {
      "const": "ja"
    },
    "targetLanguages": {
      "type": "array",
      "contains": {
        "const": "vi"
      },
      "allOf": [
        {
          "contains": {
            "const": "en"
          }
        }
      ],
      "items": {
        "enum": ["vi", "en"]
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "contains": {
        "const": "japanese_transcript"
      },
      "allOf": [
        {
          "contains": {
            "const": "ja_to_vi"
          }
        },
        {
          "contains": {
            "const": "ja_to_en"
          }
        }
      ],
      "items": {
        "enum": ["japanese_transcript", "ja_to_vi", "ja_to_en"]
      },
      "uniqueItems": true
    },
    "runtime": {
      "type": "object",
      "properties": {
        "engine": {
          "enum": ["sherpa-onnx", "whisper.cpp", "prototype"]
        },
        "minimumAppVersion": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "sizeBytes"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
